QWidget {
    background-color: #f4f7fb;
    color: #203047;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    font-size: 10.5pt;
}

QWidget#MainWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #f5f8fc,
        stop: 0.52 #eef4fb,
        stop: 1 #e7eef8
    );
}

QGroupBox {
    background-color: rgba(255, 255, 255, 0.93);
    border: 1px solid #d8e2ef;
    border-radius: 16px;
    margin-top: 16px;
    padding: 18px 14px 14px 14px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #27496d;
    background-color: #f4f7fb;
}

QLabel {
    background: transparent;
}

QLabel#ReceiveStatusLabel {
    background-color: rgba(255, 255, 255, 0.88);
    border: 1px solid #d4dfec;
    border-radius: 12px;
    padding: 10px 12px;
    color: #24415f;
    font-weight: 600;
}

QLineEdit,
QSpinBox,
QComboBox,
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #c8d6e6;
    border-radius: 10px;
    padding: 7px 10px;
    selection-background-color: #3f7cc4;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 1px solid #3f7cc4;
}

QComboBox::drop-down {
    width: 28px;
    border: none;
    background: transparent;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 20px;
    background: transparent;
    border: none;
}

QPushButton {
    background-color: #2f6fb2;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 9px 18px;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #255f9b;
}

QPushButton:pressed {
    background-color: #1d4d7d;
}

QPushButton:disabled {
    background-color: #a3b7cc;
    color: #edf3f9;
}

QProgressBar {
    background-color: #dae5f1;
    border: none;
    border-radius: 11px;
    text-align: center;
    color: #18314f;
    min-height: 22px;
    font-weight: 700;
}

QProgressBar::chunk {
    border-radius: 11px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #34a0a4,
        stop: 1 #168aad
    );
}

QTextEdit {
    background-color: #fbfdff;
    border-radius: 14px;
    line-height: 1.35;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 0 4px 0;
}

QScrollBar::handle:vertical {
    background: #b8cae0;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}
